APP_NAME=Starter Template
APP_ENV=development
APP_ORIGIN=http://localhost:3000
APP_MARKETING_ORIGIN=http://localhost:4173

APP_DATABASE_PATH=./data/app.db
APP_SESSION_SECRET=change-me
APP_COOKIE_SECURE=false

APP_EMAIL_SEND_URL=
APP_EMAIL_SEND_AUTH_HEADER=Authorization
APP_EMAIL_SEND_AUTH_VALUE=
APP_EMAIL_SENDER=starter-template.example.com
APP_EMAIL_FROM=no-reply@starter-template.example.com
APP_MANUAL_SES_IDENTITY=true
APP_ENABLE_MARKETING_SITE=true
APP_MARKETING_DOMAIN=starter-template.example.com

APP_STRIPE_SECRET_KEY=
APP_STRIPE_WEBHOOK_SECRET=
APP_STRIPE_BILLING_PRICE_PRO_MONTHLY=
APP_STRIPE_BILLING_PRICE_TEAM_MONTHLY=
APP_STRIPE_BILLING_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/complete?checkout=success
APP_STRIPE_BILLING_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/complete?checkout=cancelled
APP_STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/settings?billing=returned
